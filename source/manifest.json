{
  "manifest_version": 2,
  "name": "Missing shortcuts",
  "version": "0.0.3",
  "description": "Adds an option to configure missing shortcuts to the browser.",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "permissions": [
    "tabs"
  ],
  "icons": {
    "48": "icon-48.png",
    "96": "icon-48.png"
  },
  "browser_action": {
    "default_title": "Configure shortcuts",
    "default_icon": {
      "16": "icon-48.png",
      "32": "icon-48.png"
    }
  },
  "commands": {
    "move-tab-to-new-window": {
      "description": "Move current tab to a new window"
    },
    "move-tab-to-new-blank-window": {
      "description": "Move current tab to a new blank window (no Essentials)"
    },
    "duplicate-tab": {
      "description": "Duplicate current tab"
    },
    "move-tab-to-next-window": {
      "description": "Move current tab to next window"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "move-tab-to-new-window@victor.dev",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
